# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventify_db?schema=public"

# JWT Secrets & Expiration
JWT_ACCESS_SECRET="eventify_jwt_access_secret_super_secret_key_change_in_production"
JWT_REFRESH_SECRET="eventify_jwt_refresh_secret_super_secret_key_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
