// Eventify SaaS - Prisma Database Schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. User Model (Global Identity: Customers, Staff, Admins)
// -------------------------------------------------------------
model User {
  id                 String                   @id @default(uuid()) @db.Uuid
  name               String                   @db.VarChar(100)
  email              String                   @unique @db.VarChar(255)
  phone              String?                  @db.VarChar(20)
  avatarUrl          String?                  @map("avatar_url") @db.Text
  googleId           String?                  @unique @map("google_id") @db.VarChar(255)
  status             String                   @default("ACTIVE") @db.VarChar(20) // ACTIVE, INACTIVE, SUSPENDED
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  memberships        OrganizationMember[]
  invitationsCreated OrganizationInvitation[] @relation("InvitationCreator")

  @@map("users")
}

// -------------------------------------------------------------
// 2. OTP Verification Model (Passwordless Auth & Verification)
// -------------------------------------------------------------
model OtpVerification {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @db.VarChar(255)
  otpHash   String   @map("otp_hash") @db.VarChar(255)
  purpose   String   @default("LOGIN") @db.VarChar(50) // LOGIN, STAFF_INVITE
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, purpose])
  @@map("otp_verifications")
}

// -------------------------------------------------------------
// 3. Organization Model (Multi-Tenant Company Workspace)
// -------------------------------------------------------------
model Organization {
  id          String                   @id @default(uuid()) @db.Uuid
  name        String                   @db.VarChar(150)
  slug        String                   @unique @db.VarChar(150)
  status      String                   @default("ACTIVE") @db.VarChar(20) // ACTIVE, SUSPENDED
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  members        OrganizationMember[]
  invitations    OrganizationInvitation[]
  venues         Venue[]
  venueContracts VenueContract[]
  events         Event[]

  @@map("organizations")
}

// -------------------------------------------------------------
// 4. Organization Member Model (Maps Users to Organizations with Roles)
// -------------------------------------------------------------
model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  status         String       @default("ACTIVE") @db.VarChar(20) // ACTIVE, INACTIVE
  joinedAt       DateTime     @default(now()) @map("joined_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@map("organization_members")
}

// -------------------------------------------------------------
// 5. Role Model (RBAC: System Roles and Organization Roles)
// -------------------------------------------------------------
model Role {
  id              String                   @id @default(uuid()) @db.Uuid
  organizationId  String?                  @map("organization_id") @db.Uuid
  name            String                   @db.VarChar(100)
  description     String?                  @db.Text
  createdAt       DateTime                 @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  members         OrganizationMember[]
  invitations     OrganizationInvitation[]

  @@map("roles")
}

// -------------------------------------------------------------
// 6. Permission Model (Granular Action Rights)
// -------------------------------------------------------------
model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique @db.VarChar(100)
  description     String?          @db.Text

  rolePermissions RolePermission[]

  @@map("permissions")
}

// -------------------------------------------------------------
// 7. Role Permission Model (Many-to-Many join for Roles & Permissions)
// -------------------------------------------------------------
model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// -------------------------------------------------------------
// 8. Organization Invitation Model (Staff Invite Tokens)
// -------------------------------------------------------------
model OrganizationInvitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  email          String       @db.VarChar(255)
  token          String       @unique @db.VarChar(255)
  expiresAt      DateTime     @map("expires_at")
  maxUses        Int?         @default(1) @map("max_uses")
  usedCount      Int          @default(0) @map("used_count")
  status         String       @default("ACTIVE") @db.VarChar(20) // ACTIVE, EXPIRED, DISABLED
  createdBy      String       @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])
  creator        User         @relation("InvitationCreator", fields: [createdBy], references: [id])

  @@map("organization_invitations")
}

// -------------------------------------------------------------
// 9. Physical Venue Master Model (Reusable Real Estate Master)
// -------------------------------------------------------------
model Venue {
  id               String                @id @default(uuid()) @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  name             String                @db.VarChar(150)
  description      String?               @db.Text
  address          String                @db.Text
  city             String                @db.VarChar(100)
  state            String?               @db.VarChar(100)
  country          String                @default("India") @db.VarChar(100)
  postalCode       String?               @map("postal_code") @db.VarChar(20)
  
  // Venue Management Contact
  contactName      String?               @map("contact_name") @db.VarChar(100)
  contactEmail     String?               @map("contact_email") @db.VarChar(255)
  contactPhone     String?               @map("contact_phone") @db.VarChar(20)

  // Physical Limits
  capacity         Int                   @default(0)

  // Facilities, Rules & Media
  facilities       String[]              @default([])
  rules            String?               @db.Text
  images           String[]              @default([])

  // Status & Audit
  status           String                @default("ACTIVE") @db.VarChar(20) // ACTIVE, INACTIVE, ARCHIVED
  createdBy        String?               @map("created_by") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  deletedAt        DateTime?             @map("deleted_at")

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  seatingLayouts   VenueSeatingLayout[]
  contracts        VenueContract[]
  events           Event[]

  @@index([organizationId, status])
  @@map("venues")
}

// -------------------------------------------------------------
// 10. Per-Event Commercial Deal / Contract Model
// -------------------------------------------------------------
model VenueContract {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  venueId            String       @map("venue_id") @db.Uuid
  dealTitle          String       @map("deal_title") @db.VarChar(200)
  eventName          String?      @map("event_name") @db.VarChar(200)
  eventId            String?      @map("event_id") @db.Uuid
  
  // Dates & Duration
  startDate          DateTime     @map("start_date")
  endDate            DateTime     @map("end_date")
  totalDays          Int          @map("total_days")

  // Capacity provided by Venue for this specific event
  allocatedCapacity  Int          @default(0) @map("allocated_capacity")
  
  // Commercial Pricing & Breakdown
  rentalAmount       Decimal      @map("rental_amount") @db.Decimal(10, 2)
  currency           String       @default("INR") @db.VarChar(10)
  securityDeposit    Decimal      @default(0) @map("security_deposit") @db.Decimal(10, 2)
  cleaningFee        Decimal      @default(0) @map("cleaning_fee") @db.Decimal(10, 2)
  electricityCharges Decimal      @default(0) @map("electricity_charges") @db.Decimal(10, 2)
  otherCharges       Decimal      @default(0) @map("other_charges") @db.Decimal(10, 2)
  totalCost          Decimal      @map("total_cost") @db.Decimal(10, 2)

  // Payment Tracking
  paidAmount         Decimal      @default(0) @map("paid_amount") @db.Decimal(10, 2)
  paymentStatus      String       @default("PENDING") @map("payment_status") @db.VarChar(30) // PENDING, PARTIALLY_PAID, PAID, REFUNDED
  
  // Status & Notes
  contractStatus     String       @default("DRAFT") @map("contract_status") @db.VarChar(30) // DRAFT, NEGOTIATING, CONFIRMED, CANCELLED, COMPLETED
  terms              String?      @db.Text
  notes              String?      @db.Text
  contractUrl        String?      @map("contract_url") @db.Text
  notifiedAt         DateTime?    @map("notified_at")

  createdBy          String?      @map("created_by") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venue              Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  events             Event[]

  @@index([organizationId, venueId])
  @@map("venue_contracts")
}

// -------------------------------------------------------------
// 11. Seating Layout Model
// -------------------------------------------------------------
model VenueSeatingLayout {
  id          String      @id @default(uuid()) @db.Uuid
  venueId     String      @map("venue_id") @db.Uuid
  name        String      @db.VarChar(150)
  description String?     @db.Text
  isDefault   Boolean     @default(false) @map("is_default")
  totalSeats  Int         @default(0) @map("total_seats")
  status      String      @default("ACTIVE") @db.VarChar(20) // ACTIVE, INACTIVE
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  venue       Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  seats       VenueSeat[]
  events      Event[]

  @@index([venueId])
  @@map("venue_seating_layouts")
}

// -------------------------------------------------------------
// 12. Venue Seat Model (Canvas Coordinates)
// -------------------------------------------------------------
model VenueSeat {
  id         String             @id @default(uuid()) @db.Uuid
  layoutId   String             @map("layout_id") @db.Uuid
  seatNumber String             @map("seat_number") @db.VarChar(20)
  rowNumber  String?            @map("row_number") @db.VarChar(20)
  section    String             @default("General") @db.VarChar(100)
  seatType   String             @default("STANDARD") @map("seat_type") @db.VarChar(50)
  xPosition  Decimal            @map("x_position") @db.Decimal(10, 2)
  yPosition  Decimal            @map("y_position") @db.Decimal(10, 2)
  status     String             @default("ACTIVE") @db.VarChar(20)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  layout     VenueSeatingLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@unique([layoutId, seatNumber])
  @@index([layoutId])
  @@map("venue_seats")
}

// -------------------------------------------------------------
// 13. Event Model (Main Event Entity)
// -------------------------------------------------------------
model Event {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  venueId            String              @map("venue_id") @db.Uuid
  venueContractId    String?             @map("venue_contract_id") @db.Uuid
  seatingLayoutId    String?             @map("seating_layout_id") @db.Uuid

  title              String              @db.VarChar(200)
  slug               String              @db.VarChar(250)
  description        String              @db.Text
  shortDescription   String?             @map("short_description") @db.VarChar(500)
  category           String              @db.VarChar(50) // MUSIC, TECH, COMEDY, SPORTS, WORKSHOP
  tags               String[]            @default([])
  performers         String?             @db.Text        // e.g. "Coldplay, Imagine Dragons"
  ageRestriction     String              @default("ALL_AGES") @map("age_restriction") @db.VarChar(20) // ALL_AGES, 16+, 18+

  // Cloudinary Media CDN Assets
  bannerUrl          String?             @map("banner_url") @db.Text
  thumbnailUrl       String?             @map("thumbnail_url") @db.Text
  galleryUrls        String[]            @default([]) @map("gallery_urls")

  // Overall Event Dates
  startDate          DateTime            @map("start_date")
  endDate            DateTime            @map("end_date")

  // Capacity & Status
  totalCapacity      Int                 @default(0) @map("total_capacity")
  status             String              @default("DRAFT") @db.VarChar(20) // DRAFT, PUBLISHED, CANCELLED, COMPLETED, ARCHIVED
  isFeatured         Boolean             @default(false) @map("is_featured")

  createdBy          String?             @map("created_by") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venue              Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  venueContract      VenueContract?      @relation(fields: [venueContractId], references: [id], onDelete: SetNull)
  seatingLayout      VenueSeatingLayout? @relation(fields: [seatingLayoutId], references: [id], onDelete: SetNull)

  sessions           EventSession[]
  ticketTiers        EventTicketTier[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([category, status])
  @@map("events")
}

// -------------------------------------------------------------
// 14. Event Session Model (Multi-Day / Showtimes / Time Slots)
// -------------------------------------------------------------
model EventSession {
  id           String    @id @default(uuid()) @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  title        String    @db.VarChar(150) // e.g. "Day 1 - Evening Concert", "Matinee Show"
  description  String?   @db.Text
  startTime    DateTime  @map("start_time")
  endTime      DateTime  @map("end_time")
  status       String    @default("SCHEDULED") @db.VarChar(20) // SCHEDULED, RUNNING, COMPLETED, CANCELLED

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, startTime])
  @@map("event_sessions")
}

// -------------------------------------------------------------
// 15. Event Ticket Tier Model (VIP, Gold Recliner, Normal)
// -------------------------------------------------------------
model EventTicketTier {
  id                String    @id @default(uuid()) @db.Uuid
  eventId           String    @map("event_id") @db.Uuid
  name              String    @db.VarChar(100) // "VIP Stagefront", "Gold Recliner", "Normal"
  seatType          String    @default("STANDARD") @map("seat_type") @db.VarChar(50) // VIP, GOLD, RECLINER, STANDARD, ACCESSIBLE
  price             Decimal   @db.Decimal(10, 2)
  currency          String    @default("INR") @db.VarChar(10)

  totalQuantity     Int       @map("total_quantity")
  availableQuantity Int       @map("available_quantity")
  maxPerOrder       Int       @default(6) @map("max_per_order")

  salesStartTime    DateTime? @map("sales_start_time")
  salesEndTime      DateTime? @map("sales_end_time")
  description       String?   @db.Text
  status            String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, SOLD_OUT, INACTIVE

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  event             Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@map("event_ticket_tiers")
}


